<?xml version="1.0" encoding="UTF-8" ?>

<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
    <!-- property definitions-->

    <springProperty name="LOG_PATH" source="application.log.file.path"/>
    <property name="LOG_PATTERN"
              value="%green(%d{yyyy-MM-dd'T'HH:mm:ss, UTC}) %highlight(%-5level) [%blue(%t)] %yellow(%C): %msg[%X]%n%throwable"/>
    <springProperty name="ROOT_LOGGING_LEVEL" source="application.root.logging.level"/>
    <springProperty name="MAX_FILE_SIZE" source="application.log.max.file.size"/>
    <springProperty name="MAX_HISTORY" source="application.log.max.history"/>
    <springProperty name="TOTAL_SIZE_CAP" source="application.log.total.size.cap"/>

    <!-- Console Appender for debug -->
    <appender name="CONSOLE_DEBUG" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <jsonGeneratorDecorator class="net.logstash.logback.decorate.PrettyPrintingJsonGeneratorDecorator"/>
            <timeZone>UTC</timeZone>
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss</timestampPattern>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <stackTrace>stackTrace</stackTrace>
                <logger>loggerName</logger>
                <thread>threadName</thread>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
        </encoder>
    </appender>

    <!-- File Appender -->
    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/creative-lines.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archived-loge-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- each file should be at most ${MAX_FILE_SIZE}, keep history of ${MAX_HISTORY} days at most ${TOTAL_SIZE_CAP} -->
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>

        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss</timestampPattern>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <stackTrace>stackTrace</stackTrace>
                <logger>loggerName</logger>
                <thread>threadName</thread>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
        </encoder>
    </appender>

    <appender name="ASYNC_APPENDER" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <appender-ref ref="ROLLING_FILE"/>
    </appender>

    <!-- Root logger -->
    <springProfile name="dev">
        <root level="${ROOT_LOGGING_LEVEL}">
            <appender-ref ref="CONSOLE_DEBUG"/>
            <appender-ref ref="ASYNC_APPENDER"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <root level="${ROOT_LOGGING_LEVEL}">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_APPENDER"/>
        </root>
    </springProfile>

</configuration>